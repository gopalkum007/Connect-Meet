# Server Port
PORT=8000

# Environment: development | production
NODE_ENV=production

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/connectmeet

# JWT Configuration
JWT_SECRET=replace-with-a-strong-production-secret
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated, or * for open access)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Azure Cognitive Translation (Optional - for real-time multilingual chat)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=centralindia

# LibreTranslate Alternative (Optional)
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_KEY=

# Full-stack monolithic serving (Set to true if Express serves frontend/dist)
SERVE_STATIC=false
